    {
      "name": "Calculations - SEARCH",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status 200\", () => {\r",
              "  pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "pm.test(\"Response is JSON array\", () => {\r",
              "  pm.response.to.be.json;\r",
              "  const json = pm.response.json();\r",
              "  pm.expect(Array.isArray(json)).to.eql(true);\r",
              "});\r",
              "\r",
              "pm.test(\"Items have required fields\", () => {\r",
              "  const arr = pm.response.json();\r",
              "  if (arr.length === 0) return;\r",
              "\r",
              "  const item = arr[0];\r",
              "  pm.expect(item).to.have.property(\"id\");\r",
              "  pm.expect(item).to.have.property(\"leftValue\");\r",
              "  pm.expect(item).to.have.property(\"leftRadix\");\r",
              "  pm.expect(item).to.have.property(\"rightValue\");\r",
              "  pm.expect(item).to.have.property(\"rightRadix\");\r",
              "  pm.expect(item).to.have.property(\"operation\");\r",
              "  pm.expect(item).to.have.property(\"resultValue\");\r",
              "  pm.expect(item).to.have.property(\"resultRadix\");\r",
              "  pm.expect(item).to.have.property(\"createdAt\");\r",
              "});\r",
              "\r",
              "pm.test(\"createdAt is within [from,to]\", () => {\r",
              "  const arr = pm.response.json();\r",
              "\r",
              "  const from = new Date(pm.request.url.query.get(\"from\"));\r",
              "  const to = new Date(pm.request.url.query.get(\"to\"));\r",
              "\r",
              "  for (const item of arr) {\r",
              "    const t = new Date(item.createdAt);\r",
              "    pm.expect(t.getTime()).to.be.at.least(from.getTime());\r",
              "    pm.expect(t.getTime()).to.be.at.most(to.getTime());\r",
              "  }\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
