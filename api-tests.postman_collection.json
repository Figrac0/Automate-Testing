    {
      "name": "Calc - ADD",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status 200\", () => {\r",
              "  pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "pm.test(\"Response is JSON\", () => {\r",
              "  pm.response.to.be.json;\r",
              "});\r",
              "\r",
              "pm.test(\"Has required fields\", () => {\r",
              "  const json = pm.response.json();\r",
              "  pm.expect(json).to.have.property(\"id\");\r",
              "  pm.expect(json).to.have.property(\"result\");\r",
              "  pm.expect(json).to.have.property(\"resultRadix\");\r",
              "  pm.expect(json).to.have.property(\"createdAt\");\r",
              "});\r",
              "\r",
              "pm.test(\"Result radix matches\", () => {\r",
              "  const json = pm.response.json();\r",
              "  pm.expect(String(json.resultRadix)).to.eql(String(pm.collectionVariables.get(\"resultRadix\")));\r",
              "});\r",
              "\r",
              "pm.test(\"Correct ADD result\", () => {\r",
              "  const json = pm.response.json();\r",
              "\r",
              "  const value =\r",
              "    json?.result ??\r",
              "    json?.resultValue ??\r",
              "    json?.value ??\r",
              "    json?.result_value ??\r",
              "    json?.resultValue;\r",
              "\r",
              "  pm.expect(String(value)).to.eql(\"15\");\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        },
